# Optional: Helius (or any) Solana RPC for the cluster you deployed to.
# If omitted, the app uses the public Solana devnet endpoint.
# VITE_SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# Deployed Anchor program id (base58). After `anchor deploy`, paste the program id here
# so the frontend matches your deployment. If omitted, the app uses `address` from
# `src/idl/scholarfi_lite_contracts.json`.
# VITE_PROGRAM_ID=7JTpTv6ftwRJwyXasGjU7L1swFnrizKh7nEeHnSbVMbs

# Smoke-test after deploy:
# 1. Copy this file to `.env` and set VITE_PROGRAM_ID (+ RPC if needed).
# 2. `npm run dev`, connect a funded teacher wallet on that cluster.
# 3. Crear lista → agregar estudiante → crear curso → emitir logro (con/sin curso).
# 4. Actualizar / eliminar logro y verificar PDA/TX en Explorer.
